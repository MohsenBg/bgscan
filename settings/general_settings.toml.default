# =====================================================================
# General Scanner Settings
# =====================================================================
# The interval (in milliseconds) for pushing status updates to the UI.
# Controls how frequently progress information is refreshed.
# Example: 1000 updates the UI every 1 second.
status_interval = 1000

# The maximum number of successful results before halting the scan.
# A "successful result" is defined as a target passing the scan conditions.
#
# Behavior:
# 0 = Disabled (scan all targets)
# N = Stop after N successful hits
#
# NOTE: In pipeline mode, this limit currently applies only to the final stage.
stop_after_found = 0

# The maximum number of IPs to read from the input source.
# Useful for sampling large IP lists or limiting resource-intensive scans.
#
# Behavior:
# 0 = No limit (read all available IPs)
# N = Read at most N IPs
max_ips_to_test = 0

# Randomizes the target IP order before scanning.
# This prevents overwhelming specific subnets and helps avoid triggering firewall alerts.
shuffled = true

# =====================================================================
# Pipeline Execution Mode
# =====================================================================
# The execution mode for multi-stage scanning.
#
# Available modes:
# "sequential" → Disk-based chain. Each stage waits for the previous one
#                to finish. Lowest RAM usage, but slowest due to disk I/O.
#
# "streaming"  → Channel-based streaming. All stages run simultaneously,
#                streaming IPs via buffered channels. Highest throughput
#                and ideal for large datasets.
#
# "batch"      → Hybrid model. IPs are processed in batches, with each
#                batch going through all stages sequentially. Offers
#                predictable memory usage compared to streaming.
#
# Default: "streaming"
pipeline_mode = "streaming"

# The maximum number of IPs a pipeline stage can hold in memory.
# When this hard cap is reached, the previous stage is blocked until
# space becomes available.
#
# Leave commented out to use the platform-detected default:
#   Android low-end  → 10,000
#   Android mid      → 50,000
#   Android high-end → 100,000
#   Desktop          → 100,000
#
# Uncomment to override:
# max_ips_per_stage = 100000

# The number of IPs processed per batch when using the "batch" pipeline mode.
# Example: 1000 means each batch of 1000 IPs goes through all stages sequentially.
#
# Leave commented out to use the platform-detected default:
#   Android low-end  → 500
#   Android mid      → 2,000
#   Android high-end → 5,000
#   Desktop          → 5,000
#
# Uncomment to override:
# batch_size = 1000

# =====================================================================
# Rate Limiting & Probe Pacing
# =====================================================================
# These three settings control how aggressively the scanner fires probes.
# On Android/Termux, incorrect values here are the primary cause of
# SIGKILL crashes from socket table exhaustion and FD limit breaches.
#
# All three are AUTO-DETECTED based on your platform and available memory.
# Leave them commented out unless you know what you are changing.
#
# Platform defaults:
#
#   Profile         | min_probe_duration | probe_per_sec | probe_burst
#   ----------------|--------------------|---------------|------------
#   Android low     | 100ms              | 120           | 30
#   Android mid     | 80ms               | 150           | 50
#   Android high    | 50ms               | 200           | 100
#   Desktop         | 50ms               | 1000          | 200
#
# -----------------------------------------------------------------------

# Minimum time a probe occupies a worker slot.
# If a probe finishes faster than this, the worker sleeps the remainder
# before picking up the next probe.
# Prevents fast probes from creating socket open/close bursts that
# overwhelm the kernel before TIME_WAIT sockets are recycled.
# Unit: milliseconds
#
# Uncomment to override:
# min_probe_duration = 50

# Maximum number of probes allowed per second across ALL workers combined.
# This is a global token bucket rate — workers block until a token is available.
# Directly controls how fast sockets are opened system-wide.
# Unit: probes per second
#
# Uncomment to override:
# probe_per_sec = 500

# Maximum number of probes that can fire instantly at startup or after
# a period of inactivity (token bucket burst capacity).
# Keep this small on Android to avoid a spike of simultaneous sockets
# at scan start. A value of 5–20 is safe; 100+ will cause bursts.
#
# Uncomment to override:
# probe_burst = 100
