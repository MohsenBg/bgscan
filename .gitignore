# ------------------------------------
# General & Hugo Build Artifacts
# ------------------------------------
*.txt
public/
resources/
.hugo_build.lock
.docs-replacement-holder
*.out

# Explicitly ignore Hugo build folders inside docs 
docs/public/
docs/resources/

# ------------------------------------
# Go Build & Binary Files
# ------------------------------------
/bin/
/build/
/dist/
/out/
/coverage/
/tmp/
internal/core/result/tmp/

# Compiled binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
__debug_bin*

# Go modules (CRITICAL: go.sum MUST be tracked, only ignore vendor)
/vendor/

# Logs & Local Results
*.log
[Ll]ogs/
/result/
/[Tt]mp/

# Dependency directories
pkg/
**/pkg/

# Local environment files
.env
*.local

# Ignore everything in assets
assets/*

# Allow the required parent directories
!assets/xray/
!assets/dns-tunneling/

# Xray rules
assets/xray/xray*
assets/xray/*.dat
assets/xray/configs/
assets/xray/outbounds/*.json
!assets/xray/outbounds/*.example

# DNS tunneling:
# Ignore all files inside immediate subdirectories
assets/dns-tunneling/*/*

# Allow only .example files
!assets/dns-tunneling/*/*.example

# Ignore local user settings and generated IP lists (keeps .default files tracked)
settings/
ips/*.csv

# Ignore local builder output
bgscan-builder*

# ------------------------------------
# IDE / Editor Ignores
# ------------------------------------

# VSCode
.vscode/
.history/

# JetBrains IDEs (GoLand, IntelliJ IDEA, etc.)
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*.vim
*~
\#*\#
.\#*

# OS specific
.DS_Store
Thumbs.db
