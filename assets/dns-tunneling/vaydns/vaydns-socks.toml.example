# VayDNS tunnel server domain.
# Replace this with the domain configured for your VayDNS server.
domain = 'example.com'

# VayDNS server public key.
# This key is provided by the VayDNS tunnel server and is required.
# Must be exactly 64 hexadecimal characters.
pub_key = 'cd6d78e954f48f62cb74cdcf8a2459d3d39786a7e11fc4f74c04bca86371f748'

# Number of bytes used for the client ID.
# Valid range: 1-8.
client_id_size = 2

# Maximum length of a DNS QNAME.
# Set to 0 to use the VayDNS default.
# Valid range: 0-253.
max_qname_len = 0

# Maximum number of labels allowed in a DNS name.
# Set to 0 to use the VayDNS default.
# Valid range: 0-4.
max_num_labels = 0

# Maximum transmission unit (MTU) used by the tunnel.
# Set to 0 to use the VayDNS default.
# Valid range: 0-1452.
mtu = 0

# Maximum DNS requests per second.
# Set to 0.0 for unlimited requests.
# Valid range: 0-500.
rps = 0.0

# DNS record type used by the tunnel.
# Common values include 'a', 'aaaa', 'txt', and 'cname'.
record_type = 'txt'

# DNS resolver transport protocol.
# Supported values: 'udp', 'tcp', or 'dot' (DNS over TLS).
resolver_type = 'udp'

# Port of the DNS resolver.
# Standard DNS uses port 53; DNS over TLS commonly uses port 853.
resolver_port = 53

# uTLS client fingerprint used for DNS-over-TLS connections.
# The value must be a fingerprint supported by the uTLS implementation.
# Examples include 'chrome', 'firefox', and 'safari'.
fingerprint = 'random'

# Proxy protocol used by the tunnel.
# Supported values: 'socks' or 'ssh'.
proxy_type = 'socks'

# Local proxy server port.
proxy_port = 1080

# Proxy authentication method.
# Supported values: 'none', 'password' or 'key'.
# 'socks' proxy supports 'none' and 'password'; 'ssh' proxy supports 'password' and 'key'.
auth_method = 'password'

# Username used when auth_method is 'password' or 'key'.
username = 'your-username'

# Password used when auth_method is 'password'.
password = 'your-password'

# SSH private key used for key-based authentication.
# Leave empty when private-key authentication is not configured.
private_key = ''

# Path to the SSH known_hosts file.
# Only used when auth_method is 'key'. Leave empty to skip host verification.
known_hosts_file = ''