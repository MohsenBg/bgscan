# Slipstream server domain.
# Replace this with the domain configured for your Slipstream server.
domain = 'example.com'

# Port of the DNS resolver.
# Standard DNS uses port 53.
resolver_port = 53

# Path to the CA certificate used to verify the server certificate.
# Leave empty to use the system certificate pool.
cert_path = ''

# DNS resolution mode: 'recursive' or 'authoritative'.
dns_resolution = 'recursive'

# Enable UDP generic segmentation offload.
gso = false

# Congestion control: 'bbr' or 'cubic'.
congestion_control = 'bbr'

# Keepalive interval in seconds. 0 = library default.
keepalive_interval = 10

# Proxy protocol used for the tunnel connection.
# Supported values: 'socks' or 'ssh'.
proxy_type = 'ssh'

# SSH proxy port on the resolver host.
proxy_port = 22

# Proxy authentication method.
# Supported values: 'none', 'password' or 'key'.
# 'socks' proxy supports 'none' and 'password'; 'ssh' proxy supports 'password' and 'key'.
auth_method = 'password'

# Username used when auth_method is 'password' or 'key'.
username = 'your-username'

# Password used when auth_method is 'password'.
password = 'your-password'

# SSH private key used for key-based authentication.
# Leave empty when private-key authentication is not configured.
private_key = ''

# Path to the SSH known_hosts file.
# Only used when auth_method is 'key'. Leave empty to skip host verification.
known_hosts_file = ''